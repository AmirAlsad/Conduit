// Base.xcconfig
// Shared build settings for all team members (committed).
//
// The committed defaults here are the *least-privileged* baseline so anyone can
// clone and build with zero edits. Per-developer values (team id, bundle id) and
// any privilege-gated overrides live in Config/local.xcconfig (gitignored).

// App Identity
PRODUCT_NAME = Conduit
INFOPLIST_KEY_CFBundleDisplayName = Conduit

// Neutral committed default bundle id. Developers override APP_BUNDLE_IDENTIFIER
// in local.xcconfig with their own signing-capable id. Tests/UITests derive from
// it automatically (.tests / .uitests) via project.yml.
APP_BUNDLE_IDENTIFIER = com.conduit.Conduit

// Versioning
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 3

// --- Privilege-gated capabilities ---
// Conduit currently needs no entitlements (CallKit, the VoIP background mode, and
// the microphone are configured in Info.plist and require no paid capability). When
// a gated capability is added later (e.g. SiriKit, Associated Domains, Push), follow
// the DelirioApp pattern: default CODE_SIGN_ENTITLEMENTS here to a no-capability
// .entitlements file via an indirection variable, and let capable developers opt up
// in local.xcconfig. See docs/CONVENTIONS.md.

// Include per-developer overrides (gitignored). The `?` makes it optional, so the
// committed repo still builds when the file is absent.
#include? "local.xcconfig"
