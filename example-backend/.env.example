# ── Conduit engine configuration ──────────────────────────────────────────────
# Copy to `.env` and fill in. Every secret is optional at load time; each feature
# validates the keys it needs at point of use, so partial setups work (e.g. you
# can run the loopback bot with only Daily creds).

# Dispatcher auth — bearer token required on /connect, /credentials, /admin/*.
# Spawning bots is billable; never run the dispatcher publicly without this.
ENGINE_API_KEY=changeme-long-random-string

# ── Daily Cloud ───────────────────────────────────────────────────────────────
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1
# Base-64 HMAC secret Daily returns when you create the webhook (direct mode).
# Daily webhooks require a credit card on the account and fire domain-wide.
DAILY_WEBHOOK_SECRET=

# ── LiveKit Cloud ─────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ── live bot model stack (Deepgram STT · Groq LLM · Cartesia TTS) ─────────────
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# ── Behaviour knobs ───────────────────────────────────────────────────────────
BOT_NAME=Conduit Bot
DEFAULT_TRANSPORT=daily

# Endpointing delay (the documented turn-taking knob). 0.2 = Smart-Turn's trained
# value; raise it to give a thinking-partner more silence tolerance.
VAD_STOP_SECS=0.2

# Human-absent grace window (seconds). The bot stays this long after a drop so a
# reconnecting client resumes mid-conversation. MUST be >= the client's total
# reconnect-with-backoff budget. SHARED CONSTANT with the client team.
HUMAN_ABSENT_GRACE_SECS=60

# Backstop idle timeout (seconds) so a forgotten bot can't bill forever.
PIPELINE_IDLE_TIMEOUT_SECS=1800

# Token / room lifetimes
PAIRING_TOKEN_TTL_SECS=300
DIRECT_TOKEN_TTL_SECS=2592000
PAIRING_ROOM_EXP_SECS=3600
DIRECT_ROOM_EXP_SECS=7776000

# ── Deployment / ops ──────────────────────────────────────────────────────────
# Public HTTPS base URL of the dispatcher, used to register SFU webhooks at deploy time.
PUBLIC_BASE_URL=
LOG_LEVEL=INFO
