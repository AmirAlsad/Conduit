# ══════════════════════════════════════════════════════════════════════════════
#  Conduit engine configuration — copy to `.env` and fill in.
#
#  "Required" is per-feature, not global: every value is optional at load time,
#  and each feature validates the keys IT needs at point of use. So a minimal
#  setup only needs the vars for the features you actually run:
#
#    • Loopback over Daily pairing ........  ENGINE_API_KEY + DAILY_API_KEY
#    • Loopback over Daily direct mode ....  + DAILY_WEBHOOK_SECRET
#    • The `live` agent (any transport) ...  + DEEPGRAM_API_KEY GROQ_API_KEY CARTESIA_API_KEY
#    • Anything over LiveKit ..............  + LIVEKIT_API_KEY LIVEKIT_API_SECRET LIVEKIT_URL
#
#  GET /health needs nothing. Everything below marked OPTIONAL has a default.
# ══════════════════════════════════════════════════════════════════════════════


# ── REQUIRED to use the dispatcher ────────────────────────────────────────────
# Bearer token checked on /connect, /credentials, /inbound/* and /admin/*, and
# accepted (beside the short-lived offer tokens /connect mints) on /webrtc/*.
# Only /health and the signature-checked /webhooks/* are open. Generate one:
#   openssl rand -hex 32
# The engine refuses to start with it empty or set to an example value.
# In this reference server it is ALSO the admin key: whoever holds it can ring
# the registered phone, redirect its rings to another phone (/inbound/register),
# end calls (/admin/disconnect) and mint long-lived room tokens (/credentials).
# The pairing link/QR from scripts/pair.py embeds it, so treat that QR as this
# secret. A production server should give the phone a separate, narrower key.
ENGINE_API_KEY=


# ── REQUIRED for Daily (any Daily pairing or direct call) ─────────────────────
# REQUIRED: without it, Daily /connect, /credentials and the Daily webhook 503.
DAILY_API_KEY=
# REQUIRED for Daily DIRECT mode only (verifies the participant-joined webhook).
# Not needed for pairing. A base-64 HMAC secret YOU choose: `scripts/daily_webhook.py
# register` registers it with Daily as the webhook `hmac` (bring-your-own), so both
# sides match. Daily webhooks also require a credit card on the account.
DAILY_WEBHOOK_SECRET=
# OPTIONAL — Daily REST base URL. Default below.
DAILY_API_URL=https://api.daily.co/v1


# ── REQUIRED for LiveKit (all three together, or omit all to disable LiveKit) ──
# These three are also what verifies the LiveKit webhook (no separate secret).
# LiveKit DIRECT mode needs the webhook registered in the LiveKit Cloud dashboard
# (Settings → Webhooks → /webhooks/livekit) — see docs/direct-mode.md.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud


# ── REQUIRED for the `live` agent (none of these are needed for `loopback`) ────
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
# OPTIONAL — model / voice. Defaults below.
GROQ_MODEL=llama-3.3-70b-versatile
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
# OPTIONAL — TTS provider for the `live` bot: cartesia (default) | deepgram | groq.
# Each reuses that provider's existing key (deepgram→Aura, groq→PlayAI). The agent's
# required-keys check follows this (e.g. deepgram → CARTESIA_API_KEY not needed).
TTS_PROVIDER=cartesia


# ── OPTIONAL — behaviour knobs (all have defaults) ────────────────────────────
# Bot display name; also used to filter the bot's own join webhook.
BOT_NAME=Conduit Bot
# Transport used when /connect or /credentials omit one.
DEFAULT_TRANSPORT=daily

# Endpointing delay — the key turn-taking knob. 0.2 = Smart-Turn's trained value;
# raise it to give a thinking-partner more silence tolerance (at some latency cost).
VAD_STOP_SECS=0.2

# Human-absent grace window (seconds). The bot stays this long after a drop so a
# reconnecting client resumes mid-conversation. MUST be >= the client's total
# reconnect-with-backoff budget. SHARED CONSTANT with the client team.
HUMAN_ABSENT_GRACE_SECS=60

# Grace window (seconds) instead of the above when the human drops while the call
# is on hold (call-held): a cellular call can take the data path with it.
HELD_GRACE_SECS=600

# Ring bots (pre-connected inbound rings): the bot ends when the ring's timeout
# plus the margin passes with no answer. A push that carries a ring_timeout is
# bounded by it. For one that doesn't (the request set none, or the device doesn't
# list the ring_timeout push feature), the phone rings for ITS configured timeout
# (60 s by default, but the app can lengthen or turn it off) and the bot assumes
# RING_TIMEOUT_SECS (> 0): set it to your app's, or always send ring_timeout.
RING_TIMEOUT_SECS=60
RING_DEADLINE_MARGIN_SECS=15

# Agent-first ringing: a ring that starts its agent before the push (--inline, and
# a pre-connected pairing ring, whose room is prepared for the app's request
# during the ring) pushes once the agent's bot has joined the room, or after
# this many seconds without it (a slow or broken bot never blocks a ring;
# observed joins: 2 to 7 s). Ring bots get this much longer deadlines, so the
# wait never shortens the ring. 0 pushes every ring at once, as
# {"wait_for_bot": false} (scripts/ring.py --no-wait) does for one ring.
RING_BOT_WAIT_SECS=8

# A pre-connected pairing ring answered before the phone's credential request
# for it arrived keeps its prepared agent this many seconds for that request
# (it may still be on the way) before ending it as unclaimed.
PREPARED_CLAIM_GRACE_SECS=10

# A bot for an app that sends call-connected (it lists it in call_signals) greets
# when it arrives. If it never does (lost on the way), the bot greets anyway this
# long (seconds, >= 5 as the push contract asks) after it knows the user answered
# (at once for an ordinary call; for a ring, its "answered" receipt or the device
# joining after the answer) and the device is in the room, whichever is later.
# Keep it above the app's own sequence after it joins: its minimum connecting
# time (about 2.6 s in Conduit) plus its "Connected" (bounded at 5 s).
CALL_CONNECTED_GRACE_SECS=10

# Backstop idle timeout (seconds) so a forgotten bot can't bill forever.
PIPELINE_IDLE_TIMEOUT_SECS=1800

# Token / room lifetimes. A pairing token is short (born per call): the app
# fetches new credentials from /connect for each engine-level reconnect, so it
# matters only until the phone joins. Direct tokens are long (provisioned once
# via scripts/provision.py and pasted into the app): the app reuses them for
# every call and every reconnect, so once one expires those fail. An inline
# ring's token is reused the same way for the whole call, so it lives
# PAIRING_ROOM_EXP_SECS, as long as the pairing room (Daily closes a pairing
# room, ending its call, at that age).
PAIRING_TOKEN_TTL_SECS=300
DIRECT_TOKEN_TTL_SECS=2592000
PAIRING_ROOM_EXP_SECS=3600
DIRECT_ROOM_EXP_SECS=7776000

# Dev-runner only: which agent `python -m bot.bot` (no dispatch args) runs.
CONDUIT_AGENT=loopback
# loopback: synthesize bot-speaking state while echoing (exercises the glow).
# Set false for the truly pure pipe. RMS gate threshold for that synthetic signal.
LOOPBACK_BOT_SPEAKING=true
LOOPBACK_RMS_THRESHOLD=500


# ── OPTIONAL — inbound calls (APNs VoIP push; needed only to RING the device) ──
# One-time Apple setup (paid account): create an APNs auth key (.p8) and enable
# Push Notifications on the App ID — see the docs site's "Inbound calls" guide.
# Provide the key as a file path OR base64 (`base64 -i AuthKey_X.p8 | tr -d '\n'`).
APNS_KEY_PATH=
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
# The engine tries both APNs environments and falls back automatically, so this is
# rarely needed — it only picks which host is tried FIRST. Leave false for production
# (App Store/TestFlight); set true to try sandbox first when iterating on dev-signed
# Xcode builds of the app.
APNS_USE_SANDBOX=false
# Rarely needed: overrides the push topic (default: <registered bundle id>.voip).
APNS_TOPIC=

# SQLite file backing the registry (direct-mode rooms + VoIP tokens). Point it at
# a mounted volume (e.g. /data/registry.db) to survive redeploys; without one,
# inbound ringing self-heals on the app's next launch and direct mode needs
# re-provisioning after a redeploy.
REGISTRY_DB_PATH=registry.db


# ── OPTIONAL — deployment / ops ───────────────────────────────────────────────
# Public HTTPS base URL of the dispatcher. Not read by the server: it is the
# default --base-url of scripts/provision.py, pair.py, ring.py and
# daily_webhook.py. The server builds the URLs it hands out (a ring's status_url,
# a SmallWebRTC offer URL) from the address each request reached it at, so ring
# and pair through an address the phone can reach (for SmallWebRTC on a LAN,
# pass --base-url http://<LAN IP>:8000 even when this is set).
PUBLIC_BASE_URL=
# Log verbosity: TRACE/DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO
