# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# The AI-enhancement step (skills/aso-appstore-screenshots/scripts/edit.py) reads
# OPENAI_API_KEY from this .env file (in the project root) or from the environment.
# .env is gitignored, so your key is never committed.
#
# Note: OpenAI requires a one-time organization verification to use GPT Image models:
# https://help.openai.com/en/articles/10910291-api-organization-verification
# A 403 from the API means your org isn't verified yet.

OPENAI_API_KEY=sk-your-key-here
