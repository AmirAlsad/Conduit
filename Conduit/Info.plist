<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Conduit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Conduit only uses exempt encryption (TLS/HTTPS and WebRTC's standard media
	     encryption), so it qualifies for the export-compliance exemption. Declaring
	     this skips the per-upload encryption questionnaire in App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Portrait-only, like the Phone app on iPhone: the call/list surfaces are designed
	     vertically, and CarPlay/Bluetooth routing is independent of the app's own orientation. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Conduit places VoIP calls (CallKit + WebRTC). The voip background mode lets a
	     call keep running when the app is backgrounded / the screen is locked, and the
	     audio mode keeps the call audio session alive. See docs/CORE_SYSTEMS.md. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Conduit uses the microphone to carry your voice to your agent during a call.</string>
	<!-- SmallWebRTC agents run on the user's own machine; the first connection to a
	     LAN address triggers iOS's local-network consent prompt. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Conduit connects directly to a voice agent running on your own computer when it's on the same network.</string>
	<!-- application(_:handlerFor:) — the in-app SiriKit handler — is only invoked
	     in apps that declare multiple-scenes support (WWDC20 10073). iPhone never
	     actually creates a second scene, so this is declaration-only. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<!-- SiriKit calling domain, handled in-app (no extension): "Hey Siri, call
	     <agent>" resolves against the user's agents via SiriCallHandler. -->
	<key>NSSiriUsageDescription</key>
	<string>Conduit lets Siri start calls to your agents by name.</string>
	<key>INIntentsSupported</key>
	<array>
		<string>INStartCallIntent</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INStartCallIntent</string>
	</array>
	<!-- Requested only when you edit an agent that you've added to Contacts: Conduit keeps that
	     one contact's name and photo in sync. It never reads or changes your other contacts. -->
	<key>NSContactsUsageDescription</key>
	<string>Conduit keeps the contact you added for an agent in sync — updating its name and photo when you edit the agent. It never touches your other contacts.</string>
	<!-- conduit://add-agent links pre-fill the Add Agent form (QR pairing). The link
	     may carry an API key, so it must never be logged — see DeepLinkParser. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.amiralsad.Conduit</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>conduit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
