<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Conduit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Portrait-only, like the Phone app on iPhone: the call/list surfaces are designed
	     vertically, and CarPlay/Bluetooth routing is independent of the app's own orientation. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Conduit places VoIP calls (CallKit + WebRTC). The voip background mode lets a
	     call keep running when the app is backgrounded / the screen is locked, and the
	     audio mode keeps the call audio session alive. See docs/CORE_SYSTEMS.md. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Conduit uses the microphone to carry your voice to your agent during a call.</string>
	<!-- Requested only when you edit an agent that you've added to Contacts: Conduit keeps that
	     one contact's name and photo in sync. It never reads or changes your other contacts. -->
	<key>NSContactsUsageDescription</key>
	<string>Conduit keeps the contact you added for an agent in sync — updating its name and photo when you edit the agent. It never touches your other contacts.</string>
	<!-- conduit://add-agent links pre-fill the Add Agent form (QR pairing). The link
	     may carry an API key, so it must never be logged — see DeepLinkParser. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.amiralsad.Conduit</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>conduit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
